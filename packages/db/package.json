    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@better-spa/observability": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
