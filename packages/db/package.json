{
  "name": "@better-spa/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts",
    "./repositories": "./src/repositories/index.ts"
  },
  "scripts": {
    "kysely": "kysely",
    "build:migrate": "tsup --config ./tsup.migrate.config.ts",
    "migrate:db": "node --env-file-if-exists=../../.env dist/migrate/index.mjs",
    "db:snapshot": "node --env-file-if-exists=../../.env src/snapshot.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@better-spa/observability": "workspace:*",
    "kysely": "catalog:",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "kysely-ctl": "^0.21.0",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  }
}
