{
  "name": "@better-spa/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rbac": "./src/rbac.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "auth:secret": "node --env-file-if-exists=../../.env node_modules/@better-auth/cli/dist/index.mjs secret",
    "auth:generate": "node --env-file-if-exists=../../.env node_modules/@better-auth/cli/dist/index.mjs generate --config auth.config.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@better-spa/db": "workspace:*",
    "better-auth": "catalog:",
    "kysely": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
