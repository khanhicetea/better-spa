{
  "name": "@better-spa/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "pnpm build:node",
    "build:node": "vite build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "preview": "node --env-file=../../.env .output/server/index.mjs",
    "start": "node .output/server/index.mjs",
    "check-types": "tsc --noEmit",
    "worker:types": "wrangler types --config wrangler.jsonc --env-file .env.types",
    "worker:types:check": "wrangler types --config wrangler.jsonc --env-file .env.types --check",
    "worker:preview": "pnpm build:worker && vite preview --config vite.worker.config.ts --host 127.0.0.1 --port 4173",
    "worker:deploy": "pnpm build:worker && wrangler deploy --config dist/server/wrangler.json",
    "worker:dry-run": "pnpm build:worker && wrangler deploy --dry-run --config dist/server/wrangler.json",
    "ui": "pnpm dlx shadcn@latest"
  },
  "dependencies": {
    "@better-spa/auth": "workspace:*",
    "@better-spa/db": "workspace:*",
    "@better-spa/observability": "workspace:*",
    "@better-spa/rpc": "workspace:*",
    "@better-spa/shared": "workspace:*",
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@t3-oss/env-core": "^0.13.11",
    "@tanem/react-nprogress": "^6.0.3",
    "@tanstack/query-core": "^5.100.9",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.65",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "nitro": "3.0.1-alpha.2",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@types/node": "catalog:",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "^8.0.13",
    "wrangler": "4.114.0"
  }
}
