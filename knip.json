{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx"]
    },
    "apps/mobile": {
      "entry": ["src/app/**/*.tsx"],
      "ignoreDependencies": ["expo-updates", "react-native-worklets"]
    },
    "packages/auth": {
      "entry": ["src/**/*.ts", "auth.config.ts"]
    },
    "packages/db": {
      "entry": ["src/**/*.ts"]
    }
  },
  "ignore": ["apps/web/src/components/ui/**"]
}
