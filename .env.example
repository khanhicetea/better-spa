# Required for Node development and deployment.
VITE_BASE_URL=http://localhost:3000
DATABASE_URL="postgresql://user:password@localhost:5432/postgres"

# Generate with `pnpm auth:secret`. `pnpm setup` fills this without printing it.
BETTER_AUTH_SECRET=

# Node runtime controls.
# HOST=0.0.0.0
# DATABASE_MAX_CONNECTIONS=2
# TRUST_PROXY=false
# API_BODY_LIMIT_BYTES=1048576
# REQUEST_DEADLINE_MS=30000

# Structured logging: debug | info | warn | error.
# LOG_LEVEL=info

# Optional response compression for /api/rpc.
# RPC_COMPRESSION=1

# Optional OAuth. Configure callbacks as:
# http://localhost:3000/api/auth/callback/<provider>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional private S3-compatible storage. All five values enable upload capability.
# For Cloudflare R2, use its S3 API endpoint and region `auto`.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto

# Cloudflare production notes:
# - HYPERDRIVE and ASSETS are Wrangler bindings, not environment variables.
# - Set BETTER_AUTH_SECRET, DATABASE_URL-independent OAuth values, and S3 values with
#   `wrangler secret put <NAME>`.
# - Hyperdrive supplies the PostgreSQL connection string at runtime.
